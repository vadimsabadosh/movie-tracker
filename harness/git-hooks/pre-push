#!/bin/sh
# Git-level guardrails (docs/guardrails.md), independent of the agent IDE.
# stdin: <local ref> <local sha> <remote ref> <remote sha> per pushed ref.

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  name=${remote_ref#refs/heads/}

  # B1: main changes only through a merged pull request on GitHub.
  case "$name" in
    main|master)
      echo "guardrail B1: push to '$name' is blocked; open a pull request instead." >&2
      status=1; continue ;;
  esac

  # B3: prN branches are kept for sharing and never deleted.
  if [ "$local_sha" = "$zero" ]; then
    echo "guardrail B3: deleting remote branch '$name' is blocked." >&2
    status=1; continue
  fi

  # B1: no force-push — the remote tip must be an ancestor of what we push.
  if [ "$remote_sha" != "$zero" ]; then
    if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      # Fail closed: an unknown remote tip means the push cannot be proven fast-forward.
      echo "guardrail B1: remote '$name' has commits this clone does not know; run git fetch first." >&2
      status=1
    elif ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "guardrail B1: non-fast-forward push to '$name' is blocked (history rewrite)." >&2
      status=1
    fi
  fi
done

exit $status

{
  "mcpServers": {
    "vault": {
      "command": "node",
      "args": ["harness/vault-mcp/src/server.ts"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}",
        "X-MCP-Toolsets": "repos,pull_requests",
        "X-MCP-Readonly": "true"
      }
    }
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep|mcp__vault__.*|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/guard.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(../movie-tracker-vault/**)",
      "Edit(../movie-tracker-vault/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./harness/hooks/**)",
      "Edit(./harness/git-hooks/**)",
      "Edit(./docs/guardrails.md)",
      "Bash(npm publish:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
